class_name SpawnableItem
extends Resource

# =========================================================================
# SpawnableItem — универсальные настройки спавна любого объекта мира:
# деревьев, огромных валунов, кустов, пней, грибов или обломков.
#
# Объекты в мире размещаются по сетке со случайным смещением (Jittered Grid).
# Шаг сетки вычисляется автоматически: cell_size = spacing_radius * 2.0.
#
# Перед генерацией чанка список объектов автоматически сортируется
# по убыванию spacing_radius (крупные объекты спавнятся первыми).
# =========================================================================

## Название объекта для удобства в инспекторе (например: "Дуб", "Валун", "Куст")
@export var name : String = "Object"

## Меш объекта. Если null — автоматически используется процедурный BoxMesh-заглушка.
## Когда у вас появится готовая 3D-модель: просто перетащите её сюда.
@export var mesh : Mesh

## Радиус кроны / дистанция между однотипными объектами (в метрах).
## 1. Задаёт шаг сетки спавна: cell_size = spacing_radius * 2.0.
## 2. Задаёт минимальную дистанцию между кронами деревьев.
@export var spacing_radius : float = 2.5

## Радиус основания / ствола у земли (в метрах).
## 1. Используется для вырезания травы в текстуре рельефа (вместо огромного пятна кроны).
## 2. Используется для коллизий с мелкими объектами (камни/грибы могут расти под кроной вплоть до ствола).
@export var trunk_radius : float = 0.5

## Множитель вероятности появления объекта (0.0 .. 1.0).
@export var density_multiplier : float = 0.85

## Диапазон случайного масштаба экземпляров.
@export var scale_min : float = 0.8
@export var scale_max : float = 1.3

@export_group("Spawn Condition (Noise Mask)")
## Шум спавна для этого конкретного объекта.
## Если null — используется шум лесного покрова (forest_noise) по умолчанию.
## Если задан — объект спавнится по собственной карте (например, шум валунов на холмах).
@export var spawn_noise : FastNoiseLite
@export var spawn_noise_scale : float = 0.001
@export var spawn_threshold : float = 0.5
@export var spawn_curve : Curve

@export_group("Checks & Collisions")
## Проверять ли уклон склона перед спавном.
@export var check_slope : bool = true

## Максимальный уклон склона в градусах.
## Позволяет задавать индивидуальные условия:
## деревья не растут на скалах (25-35°), а валуны могут лежать на кручах (60-70°).
@export var max_slope : float = 35.0

## Проверять ли коллизии с уже заспавненными более крупными объектами.
## Если true — объект не появится, если попадает в радиус ранее размещенного объекта.
@export var check_collisions : bool = true

## Добавлять ли этот объект в список препятствий чанка.
## Деревья и крупные валуны = true (под ними вырезается трава и они блокируют спавн).
## Мелкие грибы или цветы = false (они не мешают спавну других мелких деталей и траве).
@export var is_obstacle : bool = true

## Проверять ли коллизии только со стволами крупных препятствий (деревьев).
## Если true — объект свободно растёт под кронами деревьев и игнорирует другие мелкие детали.
@export var collide_only_with_trunks : bool = false
